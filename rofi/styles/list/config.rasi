/* GamerX OS · rofi — list style (default)
 * Spotlight-like vertical list. Type-to-search.
 * Run with: rofi -show drun -theme list
 */
configuration {
    modi:                "drun,run,window,calc,emoji,filebrowser";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun:        "Apps";
    display-run:         "Run";
    display-window:      "Windows";
    display-emoji:       "Emoji";
    sidebar-mode:        false;
    matching:            "fuzzy";
    sort:                true;
    sorting-method:      "fzf";
    location:            0;
    yoffset:             80;
}

* {
    bg:        #11162A;
    bg-alt:    #1B2241;
    surface:   #2A3158;
    fg:        #E6EAF8;
    fg-dim:    #8A93B8;
    accent:    #7C3AED;
    accent-alt:#00D9FF;
    highlight: #FF2EC4;
    border:    #2A3158;

    background-color:  transparent;
    text-color:        @fg;
    font:              "Inter 12";
}

window {
    width:             720px;
    border:            1px;
    border-color:      @border;
    border-radius:     16px;
    background-color:  @bg;
    padding:           0;
}

mainbox {
    children:          [ inputbar, listview ];
    spacing:           0;
}

inputbar {
    padding:           18px 22px;
    background-color:  transparent;
    border:            0 0 1px 0;
    border-color:      @border;
    children:          [ prompt, entry ];
}

prompt {
    enabled:           true;
    padding:           0 12px 0 0;
    text-color:        @accent;
    font:              "JetBrainsMono Nerd Font 16";
}

entry {
    placeholder:        "Search apps, files, or type a query…";
    placeholder-color:  @fg-dim;
    text-color:         @fg;
    font:               "Inter 14";
}

listview {
    columns:           1;
    lines:             10;
    cycle:             true;
    dynamic:           true;
    scrollbar:         false;
    spacing:           2px;
    padding:           8px;
}

element {
    padding:           10px 14px;
    border-radius:     10px;
    border:            0 0 0 2px;
    border-color:      transparent;
    children:          [ element-icon, element-text ];
}
element selected {
    background-color:  rgba(124, 58, 237, 0.22);
    border-color:      @highlight;
}
element-icon {
    size:              28px;
    padding:           0 10px 0 0;
}
element-text {
    text-color:        inherit;
    vertical-align:    0.5;
}
element selected normal { text-color: @fg; }
element normal normal   { text-color: @fg; }
element alternate normal { text-color: @fg; }
